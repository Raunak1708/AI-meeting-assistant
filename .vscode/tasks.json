{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install/repair project dependencies",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["-m", "pip", "install", "-r", "${workspaceFolder}\\requirements.txt"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "Run Streamlit app (project environment)",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["-m", "streamlit", "run", "${workspaceFolder}\\app.py"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        }
    ]
}
